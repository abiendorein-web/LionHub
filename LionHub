local function addToHistory(name)
    table.insert(History, 1, {name = name, time = os.time()})
    while #History > 40 do table.remove(History) end
    saveJson("LionHub_History.json", History)
end

local lofiSound, lofiTween = nil, nil

local function startLofi()
    if not Settings.lofiOn or not soundEnabled then return end
    if lofiSound and lofiSound.Parent then return end
    pcall(function()
        lofiSound = Instance.new("Sound")
        lofiSound.SoundId = SoundIds.lofi
        lofiSound.Volume = 0
        lofiSound.Looped = true
        lofiSound.Parent = SoundService
        lofiSound:Play()
        if lofiTween then lofiTween:Cancel() end
        lofiTween = TweenService:Create(lofiSound, TweenInfo.new(0.8), {Volume = 0.6 * masterVolume})
        lofiTween:Play()
    end)
end

local function stopLofi()
    if not (lofiSound and lofiSound.Parent) then return end
    pcall(function()
        local current = lofiSound
        lofiSound = nil
        if lofiTween then lofiTween:Cancel() end
        lofiTween = TweenService:Create(current, TweenInfo.new(0.6), {Volume = 0})
        lofiTween:Play()
        task.delay(0.7, function()
            pcall(function() current:Stop() current:Destroy() end)
        end)
    end)
end

