local function executeScriptUrl(url)
    local code
    local fetchOk, fetchErr = pcall(function()
        if syn and syn.request then
            code = syn.request({Url = url, Method = "GET"}).Body
        elseif http_request then
            code = http_request({Url = url, Method = "GET"}).Body
        elseif request then
            code = request({Url = url, Method = "GET"}).Body
        else
            code = game:HttpGet(url)
        end
    end)
    if not fetchOk then error("Fetch failed: " .. tostring(fetchErr)) end
    if not code or code == "" then error("Empty response") end
    if #code < 50 then error("Response too short: " .. #code .. " bytes") end
    local func, loadErr = loadstring(code)
    if not func then error("Loadstring failed: " .. tostring(loadErr)) end
    func()
end

