local function filterScripts(tabName, searchQuery)
    local targetType = string.lower(tabName)
    local query = (searchQuery and searchQuery ~= "") and string.lower(searchQuery) or nil
    for _, child in ipairs(ScriptScroll:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end
    if targetType == "leaderboard" then makeLeaderboard() CountLabel.Text = "Lion Hub Staff" ScriptScroll.CanvasPosition = Vector2.new(0, 0) return end
    if targetType == "settings" then makeSettings() CountLabel.Text = "Settings" ScriptScroll.CanvasPosition = Vector2.new(0, 0) return end
    if targetType == "info" then makeInfo() CountLabel.Text = "" ScriptScroll.CanvasPosition = Vector2.new(0, 0) return end
    if targetType == "history" then makeHistory() CountLabel.Text = "Recent executions" ScriptScroll.CanvasPosition = Vector2.new(0, 0) return end
    local matched = {}
    for _, data in ipairs(ScriptData) do
        local isMatch = true
        if query then
            if query == "keyless" then isMatch = data.keyStatus == "keyless"
            elseif query == "keyed" then isMatch = data.keyStatus == "keyed"
            elseif query == "fav" then isMatch = isFavorite(data.name)
            else isMatch = string.find(string.lower(data.name), query, 1, true) ~= nil end
        end
        if isMatch then
            if targetType == "favorite" then isMatch = isFavorite(data.name)
            else isMatch = data.type == targetType end
        end
        if isMatch then table.insert(matched, data) end
    end
    if currentSort == "az" then
        table.sort(matched, function(a, b) return a.name < b.name end)
    end
    local count = 0
    for _, data in ipairs(matched) do
        count = count + 1
        makeScriptCard(data, count)
    end
    ScriptScroll.CanvasSize = UDim2.new(0, 0, 0, count * 86 + 20)
    if query then
        CountLabel.Text = "Search: \"" .. searchQuery .. "\" - " .. count .. " results"
    else
        CountLabel.Text = "Showing " .. count .. " scripts in " .. tabName
    end
end

local function updateTabCounters()
    for name, button in pairs(tabButtons) do
        local counter = button:FindFirstChild("Counter")
        if counter then
            local key = string.lower(name)
            local count = 0
            if key == "favorite" then
                for _, data in ipairs(ScriptData) do if isFavorite(data.name) then count = count + 1 end end
            elseif key == "leaderboard" then count = #StaffList
            elseif key == "history" then count = #History
            elseif key == "settings" or key == "info" then counter.Text = ""
            else
                for _, data in ipairs(ScriptData) do if data.type == key then count = count + 1 end end
            end
            if key ~= "settings" and key ~= "info" then counter.Text = tostring(count) end
        end
    end
end

