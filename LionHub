local floatDragging, floatDragStart, floatStartPos, floatMoved

FloatButton.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        floatDragging = true
        floatMoved = false
        floatDragStart = input.Position
        floatStartPos = FloatButton.Position
    end
end)

FloatButton.InputChanged:Connect(function(input)
    if floatDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - floatDragStart
        if math.abs(delta.X) > 5 or math.abs(delta.Y) > 5 then floatMoved = true end
        FloatButton.Position = UDim2.new(floatStartPos.X.Scale, floatStartPos.X.Offset + delta.X, floatStartPos.Y.Scale, floatStartPos.Y.Offset + delta.Y)
    end
end)

UserInput.InputEnded:Connect(function(input)
    if not floatDragging then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        floatDragging = false
        if floatMoved then
            local camera = workspace.CurrentCamera
            local viewport = camera and camera.ViewportSize or Vector2.new(1920, 1080)
            local pos = FloatButton.AbsolutePosition + FloatButton.AbsoluteSize / 2
            local snapX = pos.X < viewport.X / 2 and 0.08 or 0.92
            local snapY = pos.Y < viewport.Y / 2 and 0.1 or 0.9
            TweenService:Create(FloatButton, SmoothTween, {Position = UDim2.new(snapX, 0, snapY, 0)}):Play()
            Settings.floatX = snapX
            Settings.floatY = snapY
            saveJson("LionHub_Settings.json", Settings)
        end
    end
end)

