local function makePill(text, color, parent, xOffset)
    local pill = Instance.new("Frame", parent)
    pill.Position = UDim2.new(0, xOffset, 0, 34)
    pill.Size = UDim2.new(0, #text * 7 + 14, 0, 16)
    pill.BackgroundColor3 = color
    pill.BackgroundTransparency = 0.75
    pill.BorderSizePixel = 0
    pill.ZIndex = 17
    addScaleCorner(pill, 0.5)
    addStroke(pill, 1, color)
    local label = Instance.new("TextLabel", pill)
    label.Size = UDim2.new(1, 0, 1, 0)
