    local isKeyless = data.keyStatus == "keyless"
    makePill(isKeyless and "KEYLESS" or "KEYED", isKeyless and Colors.cyan or Colors.gold, card, 108)

    local descLabel = Instance.new("TextLabel", card)
    descLabel.Size = UDim2.new(1, -120, 0, 14)
    descLabel.Position = UDim2.new(0, 42, 0, 54)
    descLabel.BackgroundTransparency = 1
    descLabel.Font = Enum.Font.Gotham
    descLabel.Text = data.description or ""
    descLabel.TextColor3 = Colors.dim
    descLabel.TextSize = 9
    descLabel.TextXAlignment = Enum.TextXAlignment.Left
    descLabel.TextTruncate = Enum.TextTruncate.AtEnd
    descLabel.ZIndex = 17

    local progressBg = Instance.new("Frame", card)
    progressBg.Size = UDim2.new(0, 200, 0, 2)
    progressBg.Position = UDim2.new(0, 42, 0, 72)
    progressBg.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
    progressBg.BorderSizePixel = 0
    progressBg.BackgroundTransparency = 1
    progressBg.ZIndex = 18
    addCorner(progressBg, 2)

    local progressBar = Instance.new("Frame", progressBg)
    progressBar.Size = UDim2.new(0, 0, 1, 0)
    progressBar.BackgroundColor3 = Colors.green
    progressBar.BorderSizePixel = 0
    progressBar.ZIndex = 19
    addCorner(progressBar, 2)
    addGradient(progressBar, {ColorSequenceKeypoint.new(0, Colors.green), ColorSequenceKeypoint.new(1, Colors.yellow)})

    local executeButton = Instance.new("TextButton", card)
    executeButton.AnchorPoint = Vector2.new(1, 0.5)
    executeButton.Position = UDim2.new(1, -12, 0.5, 0)
    executeButton.Size = UDim2.new(0, 82, 0, 32)
    executeButton.BackgroundColor3 = Colors.yellow
    executeButton.BorderSizePixel = 0
    executeButton.AutoButtonColor = false
    executeButton.Font = Enum.Font.GothamBlack
    executeButton.Text = "EXECUTE"
    executeButton.TextColor3 = Color3.fromRGB(12, 12, 16)
    executeButton.TextSize = 10
    executeButton.ZIndex = 18
    addCorner(executeButton, 8)

    executeButton.MouseButton1Click:Connect(function()
        if ActiveScripts[data.name] then return end
        ActiveScripts[data.name] = true
        local entry = ScriptRegistry[data.name]
        if not entry or not entry.url then
            playSound("fail", 0.5)
            executeButton.Text = "NO URL"
            task.wait(1)
            executeButton.Text = "EXECUTE"
            ActiveScripts[data.name] = nil
            return
        end
        if isKeyless then playSound("execute", 0.5) else playSound("keyWarn", 0.5) end
        executeButton.Text = "RUNNING"
        TweenService:Create(executeButton, FastTween, {BackgroundColor3 = Colors.green}):Play()
        progressBg.BackgroundTransparency = 0
        progressBar.Size = UDim2.new(0, 0, 1, 0)
        TweenService:Create(progressBar, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = UDim2.new(0.7, 0, 1, 0)}):Play()
        TweenService:Create(cardStroke, TweenInfo.new(0.3), {Transparency = 0, Thickness = 2, Color = Colors.yellow}):Play()
        task.spawn(function()
            local success, err = pcall(function() executeScriptUrl(entry.url) end)
            TweenService:Create(progressBar, TweenInfo.new(0.3), {Size = UDim2.new(1, 0, 1, 0)}):Play()
            if success then
                playSound("success", 0.5)
                executeButton.Text = "LOADED"
                addToHistory(data.name)
                showToast("Loaded: " .. data.name, Colors.green, "OK")
                task.wait(0.6)
            else
                playSound("fail", 0.5)
                executeButton.Text = "ERROR"
                TweenService:Create(executeButton, FastTween, {BackgroundColor3 = Colors.red}):Play()
                warn("[LION HUB] " .. data.name .. " - " .. tostring(err))
                showToast("Failed: " .. data.name, Colors.red, "X")
                task.wait(0.8)
            end
            progressBg.BackgroundTransparency = 1
            TweenService:Create(cardStroke, TweenInfo.new(0.3), {Transparency = 0.2, Thickness = 1, Color = Colors.border}):Play()
            TweenService:Create(executeButton, FastTween, {BackgroundColor3 = Colors.yellow}):Play()
            executeButton.Text = "EXECUTE"
            ActiveScripts[data.name] = nil
        end)
    end)

    return card
end

