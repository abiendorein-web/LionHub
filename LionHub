    label.Font = Enum.Font.GothamBold
    label.Text = text
    label.TextColor3 = color
    label.TextSize = 9
    label.ZIndex = 18
    return pill
end

local function makeScriptCard(data, order)
    local card = Instance.new("Frame", ScriptScroll)
