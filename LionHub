local TBounce = TweenInfo.new(0.55, Enum.EasingStyle.Back,  Enum.EasingDirection.Out)

local function corner(parent, radius)
    local uc = Instance.new("UICorner")
    uc.CornerRadius = UDim.new(0, radius or 10)
    uc.Parent = parent
    return uc
end

local function stroke(parent, thickness, color)
    local us = Instance.new("UIStroke")
    us.Thickness            = thickness or 1
    us.Color                = color or C.Border
    us.ApplyStrokeMode      = Enum.ApplyStrokeMode.Border
    us.Parent               = parent
    return us
end

local function hoverScale(btn, baseSize, basePos, growPx)
    growPx = growPx or 4
    local half = growPx / 2
    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, TFast, {
            Size     = UDim2.new(baseSize.X.Scale, baseSize.X.Offset + growPx, baseSize.Y.Scale, baseSize.Y.Offset + growPx),
            Position = UDim2.new(basePos.X.Scale, basePos.X.Offset - half, basePos.Y.Scale, basePos.Y.Offset - half),
        }):Play()
    end)
    btn.MouseLeave:Connect(function()
        TweenService:Create(btn, TFast, {Size = baseSize, Position = basePos}):Play()
    end)
    btn.MouseButton1Down:Connect(function()
        TweenService:Create(btn, TFast, {
            Size     = UDim2.new(baseSize.X.Scale, baseSize.X.Offset - 2, baseSize.Y.Scale, baseSize.Y.Offset - 2),
            Position = UDim2.new(basePos.X.Scale, basePos.X.Offset + 1, basePos.Y.Scale, basePos.Y.Offset + 1),
        }):Play()
    end)
    btn.MouseButton1Up:Connect(function()
        TweenService:Create(btn, TFast, {Size = baseSize, Position = basePos}):Play()
    end)
end

