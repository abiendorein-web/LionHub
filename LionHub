    local statusDot = Instance.new("Frame", dotHolder)
    statusDot.AnchorPoint = Vector2.new(0.5, 0.5)
    statusDot.Position = UDim2.new(0.5, 0, 0.5, 0)
    statusDot.Size = UDim2.new(0, 8, 0, 8)
    statusDot.BackgroundColor3 = Colors.greenGlow
    statusDot.BorderSizePixel = 0
    statusDot.ZIndex = 20
    addCorner(statusDot, 99)

    task.spawn(function()
        while dotHolder.Parent do
            if Settings.performance then
                task.wait(1)
            else
                local ring = Instance.new("Frame", dotHolder)
                ring.AnchorPoint = Vector2.new(0.5, 0.5)
                ring.Position = UDim2.new(0.5, 0, 0.5, 0)
                ring.Size = UDim2.new(0, 8, 0, 8)
                ring.BackgroundTransparency = 1
                ring.BorderSizePixel = 0
                ring.ZIndex = 17
                addCorner(ring, 99)
                local ringStroke = addStroke(ring, 1.5, Colors.greenGlow)
                ringStroke.Transparency = 0.2
                TweenService:Create(ring, TweenInfo.new(1.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = UDim2.new(0, 22, 0, 22)}):Play()
                TweenService:Create(ringStroke, TweenInfo.new(1.6), {Transparency = 1}):Play()
                task.delay(1.7, function() pcall(function() ring:Destroy() end) end)
                task.wait(2)
            end
        end
    end)

    task.spawn(function()
        while statusBloom.Parent do
            if Settings.performance then
                task.wait(1)
            else
                TweenService:Create(statusBloom, TweenInfo.new(1.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {Size = UDim2.new(0, 18, 0, 18), BackgroundTransparency = 0.75}):Play()
                task.wait(1.5)
                if not statusBloom.Parent then break end
                TweenService:Create(statusBloom, TweenInfo.new(1.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {Size = UDim2.new(0, 14, 0, 14), BackgroundTransparency = 0.5}):Play()
                task.wait(1.5)
            end
        end
    end)

    local titleLabel = Instance.new("TextLabel", card)
