local function loadJson(path, default)
    local ok, result
    if writefile and readfile and isfile then
        ok = pcall(function()
            if isfile(path) then result = HttpService:JSONDecode(readfile(path)) end
        end)
    end
    return (ok and result) or default or {}
end

local function saveJson(path, data)
    if writefile then
        pcall(function() writefile(path, HttpService:JSONEncode(data)) end)
    end
end

