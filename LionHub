    dotHolder.Size = UDim2.new(0, 24, 0, 24)
    dotHolder.BackgroundTransparency = 1
    dotHolder.ZIndex = 19

    local statusBloom = Instance.new("Frame", dotHolder)
    statusBloom.AnchorPoint = Vector2.new(0.5, 0.5)
    statusBloom.Position = UDim2.new(0.5, 0, 0.5, 0)
    statusBloom.Size = UDim2.new(0, 14, 0, 14)
    statusBloom.BackgroundColor3 = Colors.greenGlow
    statusBloom.BackgroundTransparency = 0.6
    statusBloom.BorderSizePixel = 0
    statusBloom.ZIndex = 18
