local function createScriptCard(data, order)
    local card = Instance.new("Frame")
    card.Name = data.name
    card.Size = UDim2.new(1, -5, 0, 66)
    card.BackgroundColor3 = C.CardBg
    card.BorderSizePixel = 0
    card.ZIndex = 16
    card.LayoutOrder = order
    card.Parent = ScrollingFrame
    corner(card, 10)
    
    local cardStroke = stroke(card, 1, C.Border)
    local cardGrad = Instance.new("UIGradient")
    cardGrad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0.00, C.Yellow),
        ColorSequenceKeypoint.new(0.25, C.White),
        ColorSequenceKeypoint.new(0.50, C.Yellow),
        ColorSequenceKeypoint.new(0.75, C.White),
        ColorSequenceKeypoint.new(1.00, C.Yellow),
    })
    cardGrad.Rotation = 0
    cardGrad.Parent = cardStroke

    local cardPulseT = 0
    RunService.RenderStepped:Connect(function(dt)
        if not (card and card.Parent) then return end
        cardPulseT = cardPulseT + dt
        cardGrad.Rotation = (cardGrad.Rotation + 40 * dt) % 360
        cardStroke.Transparency = 0.2 + (math.sin(cardPulseT * 2.5) + 1) * 0.2
    end)
    
    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, -20, 0, 20)
    title.Position = UDim2.new(0, 12, 0, 12)
    title.BackgroundTransparency = 1
    title.Font = Enum.Font.GothamBold
    title.Text = data.name
    title.TextColor3 = C.White
    title.TextSize = 13
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.ZIndex = 17
    title.Parent = card

    local statusIndicator = Instance.new("TextLabel")
    statusIndicator.Size = UDim2.new(0, 70, 0, 16)
    statusIndicator.Position = UDim2.new(0, 12, 0, 36)
    statusIndicator.BackgroundTransparency = 1
    statusIndicator.Font = Enum.Font.GothamBold
    statusIndicator.Text = data.status
    statusIndicator.TextSize = 11
    statusIndicator.TextXAlignment = Enum.TextXAlignment.Left
    statusIndicator.ZIndex = 17
    statusIndicator.Parent = card
    
    local statusStroke = Instance.new("UIStroke")
    statusStroke.Thickness = 0
    statusStroke.Parent = statusIndicator

    local statusPulseT = 0
    local statusColor = (data.status == "KEYLESS") and C.GreenGlow or C.Yellow
    
    RunService.RenderStepped:Connect(function(dt)
        if not (statusIndicator and statusIndicator.Parent) then return end
        statusPulseT = statusPulseT + dt
        local pulseAlpha = (math.sin(statusPulseT * 3) + 1) / 2
        statusIndicator.TextColor3 = statusColor:Lerp(C.White, pulseAlpha * 0.3)
        statusStroke.Transparency = 0.2 + pulseAlpha * 0.5
    end)

    local execBaseSize = UDim2.new(0, 80, 0, 30)
    local execBasePos = UDim2.new(1, -90, 0.5, -15)
    
    local execBtn = Instance.new("TextButton")
    execBtn.Name = "ExecBtn"
    execBtn.Position = execBasePos
    execBtn.Size = execBaseSize
    execBtn.BackgroundColor3 = C.Yellow
    execBtn.BorderSizePixel = 0
    execBtn.AutoButtonColor = false
    execBtn.Font = Enum.Font.GothamBlack
    execBtn.Text = "EXECUTE"
    execBtn.TextColor3 = Color3.fromRGB(12, 12, 16)
    execBtn.TextSize = 10
    execBtn.ZIndex = 17
    execBtn.Parent = card
    corner(execBtn, 8)
    
    local execGrad = Instance.new("UIGradient")
    execGrad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, C.YellowBright),
        ColorSequenceKeypoint.new(1, C.Yellow),
    })
    execGrad.Rotation = 90
    execGrad.Parent = execBtn
    
    hoverScale(execBtn, execBaseSize, execBasePos, 4)
    
    execBtn.MouseButton1Click:Connect(function()
        if activeScripts[data.name] then return end
        activeScripts[data.name] = true
        
        local execFunction = ScriptRegistry[data.name]
        if not execFunction then
            execBtn.Text = "NO LOGIC"
            task.wait(1)
            execBtn.Text = "EXECUTE"
            activeScripts[data.name] = nil
            return
        end
        
        execBtn.Text = "..."
        
        task.spawn(function()
            local success, err = pcall(execFunction)
            task.wait(1.5)
            
            if not success then
                warn("[LION HUB] Execution Error: " .. tostring(err))
            end
            
            execBtn.Text = "EXECUTE"
            activeScripts[data.name] = nil
        end)
    end)
    
    return card
end

local function filterScripts(tabName)
    local targetType = string.lower(tabName)
    local count = 0
    for _, child in ipairs(ScrollingFrame:GetChildren()) do
        if child:IsA("Frame") then
            child:Destroy()
        end
    end
    
    for _, data in ipairs(scriptData) do
        if data.type == targetType then
            count = count + 1
            createScriptCard(data, count)
        end
    end
    
    ScrollingFrame.CanvasSize = UDim2.new(0, 0, 0, count * 74)
end

local function updateTabVisuals(selectedName)
    for name, btn in pairs(tabButtons) do
        if name == selectedName then
            TweenService:Create(btn, TFast, {BackgroundColor3 = C.Yellow}):Play()
            TweenService:Create(btn, TFast, {TextColor3 = Color3.fromRGB(12, 12, 16)}):Play()
        else
            TweenService:Create(btn, TFast, {BackgroundColor3 = C.TabInactive}):Play()
            TweenService:Create(btn, TFast, {TextColor3 = C.TabText}):Play()
        end
    end
end

for name, btn in pairs(tabButtons) do
    btn.MouseButton1Click:Connect(function()
        currentTab = name
        updateTabVisuals(name)
        filterScripts(name)
    end)
end

updateTabVisuals("KEYLESS")
