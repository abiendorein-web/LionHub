    playSound("toast", 0.5)
    activeToasts[toastId] = toast
    if #activeToasts > 3 then
        for _, existingToast in pairs(activeToasts) do
            if existingToast.Parent and existingToast ~= toast then
                local temp = existingToast
                activeToasts[existingToast.LayoutOrder] = nil
                TweenService:Create(temp, FastTween, {BackgroundTransparency = 1}):Play()
                task.delay(0.2, function() temp:Destroy() end)
                break
            end
        end
