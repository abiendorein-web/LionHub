            for index, ghost in ipairs(ghostFrames) do
                local mult = index * 0.4
                local offsetX = (input.Position.X - dragStart.X) * 0.02 * mult
                local offsetY = (input.Position.Y - dragStart.Y) * 0.02 * mult
                ghost.Position = UDim2.new(newPos.X.Scale, newPos.X.Offset - offsetX, newPos.Y.Scale, newPos.Y.Offset - offsetY)
                ghost.BackgroundTransparency = 0.82 + index * 0.04
